      "id": "q02",
      "question": "How does Reciprocal Rank Fusion combine retrieval results?",
      "answerable": true,
      "gate_prediction": true,
      "gate_correct": true,
      "hit_at_k": true,
      "mrr": 1.0,
      "retrieved_sources": [
        "Hybrid Search",
